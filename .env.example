# PhishCoach AI Environment Variables
# Copy this file to .env and fill in your credentials. NEVER commit .env.

# LLM (Groq) - backend only
GROQ_API_KEY=
MODEL_GENERATE=openai/gpt-oss-120b
MODEL_COACH=openai/gpt-oss-120b
MODEL_CHAT=openai/gpt-oss-20b
MODEL_GUARD=openai/gpt-oss-20b

# DuckDB & Auth
DUCKDB_PATH=./data/phishcoach.duckdb
JWT_SECRET=
SIM_WEBHOOK_SECRET=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Mock integration endpoints
HR_API_URL=http://localhost:8001
SIM_API_URL=http://localhost:8002

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional Tracing (Langfuse or LangSmith free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phishcoach-ai
